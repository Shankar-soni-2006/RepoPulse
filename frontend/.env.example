# Copy to frontend/.env. Only VITE_-prefixed variables reach the browser —
# never put secrets here.

# Base URL of the RepoPulse API.
# Leave empty in local development: the app calls relative /api paths and the
# Vite dev server proxies them to DEV_API_PROXY_TARGET.
# Set it in production, e.g. https://api.repopulse.example.com
VITE_API_BASE_URL=

# Dev server only (not exposed to the browser): where the /api proxy forwards.
DEV_API_PROXY_TARGET=http://localhost:3001
