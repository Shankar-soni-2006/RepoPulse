# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to backend/.env and fill in all values.
# Never commit real values. Frontend variables live in
# frontend/.env.example.
# ============================================================

PORT=3001
NODE_ENV=development

# Public URL of the backend API (used to build the GitHub OAuth callback:
# ${BACKEND_URL}/api/auth/callback — register this exact URL in the GitHub App)
BACKEND_URL=http://localhost:3001

# Public URL of the frontend (CORS origin + post-login redirect)
FRONTEND_URL=http://localhost:5173

# ---- GitHub App (required) ----
# GitHub → Settings → Developer settings → GitHub Apps → your app
GITHUB_APP_ID=
# PEM private key; newlines may be written as literal \n on one line
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---- Supabase (required) ----
# Project Settings → API. The service-role key is backend-only — never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Upstash Redis (optional — analytics run uncached without it) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Gemini (optional — AI insights are disabled without it) ----
GEMINI_API_KEY=
